{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/claims", "destination": "/claims.html" },
    { "source": "/settlement", "destination": "/settlement.html" },
    { "source": "/sustainability", "destination": "/sustainability.html" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
