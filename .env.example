# ---- Database (required) -------------------------------------------------
# Turso / libSQL. Get both from the Turso dashboard: `turso db show
# <name> --url` prints the URL, and `turso db tokens create <name>` mints
# a token. The app creates its own tables on first request, so an empty
# database is all you need.
TURSO_DATABASE_URL=libsql://palimpsest-yourname.turso.io
TURSO_AUTH_TOKEN=your-real-token-here

# ---- AI insight (optional) ----------------------------------------------
# Gemini is tried first and is the one with live web search, so an insight
# can cite real sources. NVIDIA is the fallback: it reasons from the diff
# alone, with no web access. With neither set, the app still works end to
# end and the Insight tab says it isn't configured.
GEMINI_API_KEY=your-real-key-here
# NVIDIA_API_KEY=your-real-key-here

# Optional overrides, if you want a different model than the defaults.
# GEMINI_MODEL=gemini-2.5-flash
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ---- Local only ----------------------------------------------------------
# Vercel sets PORT itself; never set it in the Vercel dashboard.
# PORT=3000
